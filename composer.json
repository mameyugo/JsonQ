{
    "name": "mamel/jsonq",
    "description": "PHP stubs and build tools for JsonQ — a high-performance JSON file storage engine powered by Rust",
    "type": "php-ext-stubs",
    "license": "MIT",
    "homepage": "https://github.com/mameyugo/JsonQ",
    "keywords": ["json", "storage", "database", "rust", "extension", "nosql", "query"],
    "authors": [
        {
            "name": "Mamel",
            "email": "info@mameyugo.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "files": []
    },
    "extra": {
        "ide-stubs": "stubs/jsonq.php"
    },
    "scripts": {
        "build": "cargo build --release",
        "test": "php -d extension=$(pwd)/target/release/libjsonq.so tests/run_tests.php",
        "bench": "php -d extension=$(pwd)/target/release/libjsonq.so examples/benchmark.php"
    },
    "support": {
        "issues": "https://github.com/mameyugo/JsonQ/issues",
        "source": "https://github.com/mameyugo/JsonQ"
    }
}
